<?php

declare(strict_types=1);

namespace Module\Proxy\Credentials\{{ gateway }};

use Module\Proxy\Credentials\ProxyCredential;
use Module\Proxy\DTO\ProxyField;
use Module\Proxy\Gateway\Base\DTO\ApiGatewayConfig;

final class {{ name }}Credential extends ProxyCredential
{
    public function label(): string
    {
        return '{{ name }}';
    }

    public function group(): string
    {
        return '{{ gateway }}';
    }

    /** @return iterable<ProxyField> */
    public function fields(): iterable
    {
        return [];
    }

    /** @param  array<string, mixed>  $values */
    public function gatewayConfig(string $name, array $values, bool $mock): ApiGatewayConfig
    {
        return new ApiGatewayConfig(
            name: $name,
            baseUri: '',
            mock: $mock,
        );
    }
}
