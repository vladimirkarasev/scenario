{
  "preset": "laravel",
  "rules": {
    "final_class": true,
    "final_public_method_for_abstract_class": false,
    "ordered_imports": {
      "sort_algorithm": "alpha"
    },
    "single_quote": true,
    "array_syntax": {
      "syntax": "short"
    },
    "no_unused_imports": true,
    "ordered_class_elements": true,
    "phpdoc_align": {
      "align": "vertical"
    },
    "ternary_to_null_coalescing": true
  }
}