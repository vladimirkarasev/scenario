includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - module
    level: 10
    ignoreErrors:
        # Known Larastan limitation: relation return type covariance
        - '#but returns Illuminate\\Database\\Eloquent\\Relations\\(BelongsTo|BelongsToMany|HasMany|HasOne|MorphToMany)<.*\$this.*>#'