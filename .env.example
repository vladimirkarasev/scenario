APP_NAME=Scenario
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://scenario.localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,buggregator
# Docker: buggregator | Local: 127.0.0.1
BUGGREGATOR_HOST=buggregator
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=scenario
DB_USERNAME=scenario
DB_PASSWORD=scenario

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=roadrunner
RR_JOBS_DRIVER=boltdb
RR_JOBS_WORKERS=4
RR_HTTP_WORKERS=4
# Dev only: fresh worker per HTTP request/job, no `task reload` needed — never enable in prod (kills perf)
RR_DEBUG=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=buggregator
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
SQS_PREFIX=
SQS_QUEUE=default
SQS_SUFFIX=
SQS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"
VITE_EMBED_AUTH_REDIRECT_URL=

CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=cd261ef813b617080f4dadde374cef46f35fbc5fbf09fcd501891d91ab645c18
CENTRIFUGO_WS_URL=ws://localhost:8002/connection/websocket

EMBED_AUTH_ISSUER="${APP_NAME}"
EMBED_AUTH_SHARED_SECRET=change-me
EMBED_AUTH_TOKEN_TTL=300
EMBED_AUTH_ACCESS_TOKEN_TTL=600
DEV_AUTH_ENABLED=true

# Sentry → Buggregator (dev profile). DSN host/port must match the buggregator service.
SENTRY_LARAVEL_DSN=http://sentry@buggregator:8000/1
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_SEND_DEFAULT_PII=true

# GitHub token (public-repo read-only) for `task build` — Velox custom rr build, see docker/app/velox.toml
RT_TOKEN=
