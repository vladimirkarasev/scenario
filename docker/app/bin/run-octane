#!/usr/bin/env bash
set -euo pipefail

if [[ ! -f /var/www/html/artisan ]]; then
  echo "artisan not found; RoadRunner is waiting for Laravel app files"
  exec sleep infinity
fi

exec php artisan octane:start \
  --server=roadrunner \
  --host="${RR_HTTP_HOST:-0.0.0.0}" \
  --port="${RR_HTTP_PORT:-8080}" \
  --rpc-port="${RR_RPC_PORT:-6001}"
