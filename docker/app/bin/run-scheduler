#!/usr/bin/env bash
set -euo pipefail

if [[ "${ENABLE_SCHEDULER:-1}" != "1" ]]; then
  echo "scheduler disabled"
  exec sleep infinity
fi

if [[ ! -f /var/www/html/artisan ]]; then
  echo "artisan not found; scheduler is waiting for Laravel app files"
  exec sleep infinity
fi

exec php artisan schedule:work
