@baseUrl = http://scenario.localhost/api
@scenarioUuid = 11111111-1111-1111-1111-111111111111
@versionUuid = 22222222-2222-2222-2222-222222222222
@categoryUuid = 33333333-3333-3333-3333-333333333333
@activeVersionUuid = 44444444-4444-4444-4444-444444444444

### List scenarios
GET {{baseUrl}}/scenarios?active_only=0&search=lead&is_active=1&filter[tags][]=belgee&category_id={{categoryUuid}}&per_page=15

### Show scenario
GET {{baseUrl}}/scenarios/{{scenarioUuid}}

### Scenario versions index
GET {{baseUrl}}/scenarios/{{scenarioUuid}}/versions

### Show scenario version
GET {{baseUrl}}/scenario-versions/{{versionUuid}}

### Create scenario
POST {{baseUrl}}/scenarios
Content-Type: application/json

{
  "name": "Belgee Lead Capture",
  "description": "Scenario for Belgee lead intake.",
  "is_active": true,
  "alias": "belgee-lead",
  "tags": ["belgee", "lead", "capture"],
  "category_ids": ["{{categoryUuid}}"],
  "active_version_id": "{{activeVersionUuid}}"
}

### Update scenario
PUT {{baseUrl}}/scenarios/{{scenarioUuid}}
Content-Type: application/json

{
  "name": "Belgee Lead Capture Updated",
  "description": "Updated scenario description.",
  "is_active": true,
  "alias": "belgee-lead",
  "tags": ["belgee", "lead", "capture", "updated"],
  "category_ids": ["{{categoryUuid}}"],
  "active_version_id": "{{activeVersionUuid}}"
}

### Duplicate scenario
POST {{baseUrl}}/scenarios/{{scenarioUuid}}/duplicate
Content-Type: application/json

{}

### Delete scenario
DELETE {{baseUrl}}/scenarios/{{scenarioUuid}}

###
### Scenario versions
###

### Create version
POST {{baseUrl}}/scenarios/{{scenarioUuid}}/versions
Content-Type: application/json

{
  "name": "Main version",
  "status": "draft",
  "schema_json": {
    "nodes": [],
    "edges": []
  },
  "nodes_json": [],
  "edges_json": [],
  "schema_version": 1
}

### Update version
PUT {{baseUrl}}/scenario-versions/{{versionUuid}}
Content-Type: application/json

{
  "name": "Main version updated",
  "status": "active",
  "schema_json": {
    "nodes": [],
    "edges": []
  },
  "nodes_json": [],
  "edges_json": [],
  "schema_version": 2
}

### Duplicate version
POST {{baseUrl}}/scenario-versions/{{versionUuid}}/duplicate
Content-Type: application/json

{}

### Delete version
DELETE {{baseUrl}}/scenario-versions/{{versionUuid}}

###
### Raw checks
###

HEAD {{baseUrl}}/scenarios/{{scenarioUuid}}


###
GET {{baseUrl}}/scenarios/catalog?filter[q]=scenari
